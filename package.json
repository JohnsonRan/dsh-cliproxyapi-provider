{
  "name": "@router-for-me/dsh-cliproxyapi-provider",
  "version": "0.0.2",
  "description": "GUI-configurable CLIProxyAPI Responses provider for DeepSeek Harness",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./catalog": "./src/catalog.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["src", "client.js", "cordis.patch.yml", "README.md", "README_EN.md"],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/catalog.js && node --check client.js && node --test",
    "pack:github": "npm pack"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/router-for-me/dsh-cliproxyapi-provider.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.3",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.3",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "engines": { "node": ">=22" },
  "license": "MIT",
  "private": true
}
